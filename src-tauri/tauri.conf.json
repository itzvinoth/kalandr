{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily Tracker",
  "version": "0.1.0",
  "identifier": "com.kalandr.dailytracker",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "Daily Tracker",
        "width": 480,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
